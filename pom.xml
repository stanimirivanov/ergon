<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.raghc</groupId>
    <artifactId>rag-help-center</artifactId>
    <version>${revision}</version>
    <name>Ergon</name>
    <description>Open-source resolution engineering platform</description>
    <packaging>pom</packaging>

    <scm>
        <connection>scm:git:https://github.com/stanimirivanov/rag-help-center.git</connection>
        <developerConnection>scm:git:https://github.com/stanimirivanov/rag-help-center.git</developerConnection>
        <url>scm:git:https://github.com:stanimirivanov/rag-help-center.git</url>
        <tag>main</tag>
    </scm>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <docker.registry>fra.ocir.io</docker.registry>
        <docker.namespace>${env.OCIR_NAMESPACE}/rag-help-center</docker.namespace>
        <kotlin.version>2.4.10</kotlin.version>
        <spring-boot.version>4.1.0</spring-boot.version>
        <springdoc.version>3.0.3</springdoc.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>control-plane</module>
        <module>domain-kernel</module>
        <module>ingestion-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.raghc</groupId>
                <artifactId>domain-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>

        <!--
          kotlin-maven-plugin and flatten-maven-plugin are declared here (not just in
          pluginManagement) so every child module - and this parent - picks them up
          automatically without re-declaring them in every module. spring-boot-maven-plugin and
          jib-maven-plugin stay pluginManagement-only and are activated per-module below,
          since domain-kernel is a plain library: it must not be repackaged as an executable
          jar or containerized.
        -->
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Kotlin linter (formatting) - see https://github.com/gantsign/ktlint-maven-plugin.
                     Needs the JVM "add opens" flag on JDK 17+, already set up via .mvn/jvm.config in this repo. -->
                <groupId>com.github.gantsign.maven</groupId>
                <artifactId>ktlint-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Static analysis - see https://github.com/Ozsie/detekt-maven-plugin.
                     Runs with detekt's built-in default ruleset for now; add config/detekt/detekt.yml
                     and reference it here if/when you want custom rules. -->
                <groupId>com.github.ozsie</groupId>
                <artifactId>detekt-maven-plugin</artifactId>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!-- Resolve the version during build -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.8.0</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- Kotlin Configuration -->
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <!-- Configures executions and the stdlib dependency -->
                    <extensions>true</extensions>
                    <configuration>
                        <jvmTarget>${java.version}</jvmTarget>
                        <javaParameters>true</javaParameters>
                        <compilerPlugins>
                            <plugin>spring</plugin>
                        </compilerPlugins>
                        <args>
                            <arg>-Xjsr305=strict</arg>
                        </args>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-allopen</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <!-- Test execution -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>

                <!-- Spring Boot Configuration -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Jib Configuration: shared base image / registry / tag. Each executable module
                     activates this itself (see its pom.xml) and supplies its own container port -
                     there's no shared default port because the services don't all listen on the
                     same one. Pushing requires registry auth: `docker login fra.ocir.io` locally,
                     or JIB_TO_AUTH_USERNAME/JIB_TO_AUTH_PASSWORD env vars in CI. Nothing here reads
                     or stores credentials. -->
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <from>
                            <image>eclipse-temurin:${java.version}-jre-alpine</image>
                        </from>
                        <to>
                            <!-- Dynamically creates the image name based on the child module! -->
                            <image>${docker.registry}/${docker.namespace}/${project.artifactId}</image>
                            <tags>
                                <tag>${revision}</tag>
                            </tags>
                        </to>
                        <container>
                            <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                        </container>
                    </configuration>
                </plugin>

                <!-- ktlint: Kotlin formatting -->
                <plugin>
                    <groupId>com.github.gantsign.maven</groupId>
                    <artifactId>ktlint-maven-plugin</artifactId>
                    <version>3.7.1</version>
                    <executions>
                        <execution>
                            <id>ktlint-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- detekt: Kotlin static analysis -->
                <plugin>
                    <groupId>com.github.ozsie</groupId>
                    <artifactId>detekt-maven-plugin</artifactId>
                    <version>1.23.8</version>
                    <executions>
                        <execution>
                            <id>detekt-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
